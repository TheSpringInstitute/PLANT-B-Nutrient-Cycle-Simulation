# This file is formatted to tell Git which files to ignore for repository version tracking purposes and to maintain confidentiality and space for the repository
# This is a modified verson of GitHub's default Python .gitignore file available when creating a repository

# Have Git ignore the below file types:
# Repository-specific additions:
# Avoid storing unneeded data files to save space in the repository
data/
*.cpg
*.dbf
*.ini
*.prj
*.shx

# Do not store login credentials
.env.local
*.key
*.pem

# Default .gitignore additions for Python:
# Abstra #
.abstra/ # Tool to manage local state and credentials of Python-based workflows on the Abstra platform

# Byte-compiled files/compiled Python artifacts
__pycache__/ # Folder to store bytecode files
*$py.class # Jython-generated bytecode cache file when importing .py files
*.py[codz] # Glob pattern to match compiled Python bytecode files

# C extensions
*.so # To exclude compiled shared object files

# Cython
cython_debug/ # Cython-generated directory containing debug symbols

# Distribution / packaging
build/ # Stores temporary files when creating a package 
develop-eggs/ # Creates editable install eggs
dist/ # Holds the final distribution archives
downloads/ # Downloaded packaging assets and dependencies
*.egg # Built egg files
*.egg-info/ # Temporary metadata folder
eggs/ # Single-file package format that contains Python source code, resources, and project metadata
.eggs/ # Temporary local directory to store downloaded or intermediate egg during a build process
.installed.cfg # Plain-text configuration file to record a set up module or program
lib/ # Packaging library output
lib64/ # 64-bit packaging library output
MANIFEST # Auto-generated packaging manifest
parts/ # To ignore build folders created by old packaging systems
.Python # Build stub file
sdist/ # Source distributions
share/python-wheels/ # Shared wheel cache
var/ # Packaging variable data
wheels/ # Built wheel files

# Django
db.sqlite3 # Local SQLite database file used during development
db.sqlite3-journal # Temporary journal file SQLite creates while writing to the database
local_settings.py # Machine-specific Django settings that shouldn't be shared
*.log # Runtime log file generated by the application

# Environments
.env # File storing local environment variables
env.bak/ # Backup copy of a virtual environment folder
env/ # Local virtual environment folder
ENV/ # Local virtual environment folder, alternate naming convention
.envrc # Configuration file used by direnv to load environment variables per directory
.venv # Local virtual environment folder created by Python's venv module
venv.bak/ # Backup copy of a virtual environment folder
venv/ # Local virtual environment folder

# Flask
instance/ # Folder for instance-specific configuration not meant for version control
.webassets-cache # Cache folder used by the Flask-Assets build tool

# Installer logs
pip-delete-this-directory.txt # Marker file pip leaves behind after a failed install
pip-log.txt # Log file generated during a pip install

# IPython
ipython_config.py # Local IPython configuration file
profile_default/ # Default IPython profile folder

# Jupyter Notebook
.ipynb_checkpoints # Folder Jupyter uses to store notebook autosave checkpoints

# Marimo
marimo/_lsp/ # Cache folder for Marimo's language server
marimo/_static/ # Folder holding Marimo's static assets
__marimo__/ # Runtime folder Marimo creates while a notebook is running

# MkDocs
/site # Folder containing the built MkDocs site output

# Mypy
.dmypy.json # Status file for the Mypy daemon (dmypy)
dmypy.json # Status file for the Mypy daemon (dmypy)
.mypy_cache/ # Cache folder used to speed up repeated Mypy type checks

# PyBuilder
.pybuilder/ # Cache folder used by PyBuilder
target/ # Build output folder created by PyBuilder

# PyInstaller
*.manifest # Windows manifest file generated during a PyInstaller build
*.spec # Build specification file PyInstaller generates before bundling an executable

# PyPI
.pypirc # Local configuration file storing PyPI credentials

# Pyre
.pyre/ # Cache folder used by the Pyre type checker

# Pytype
.pytype/ # Cache folder used by the Pytype static analyzer

# Rope
.ropeproject # Project settings folder used by the Rope refactoring library

# Ruff
.ruff_cache/ # Cache folder used by the Ruff linter

# Scrapy
.scrapy # Cache folder used by the Scrapy web scraping framework

# Sphinx documentation
docs/_build/ # Folder containing generated Sphinx documentation output

# Spyder
.spyderproject # Project settings folder used by the Spyder IDE
.spyproject # Alternate project settings folder used by the Spyder IDE

# Streamlit
.streamlit/secrets.toml # File storing local Streamlit secrets

# Temp files
tempCodeRunnerFile.py # Temporary file created by the Code Runner VS Code extension

# Translations
*.mo # Compiled translation file
*.pot # Translation template file

# Unit test / coverage reports
.cache # Generic cache folder created during test runs
*.cover # Coverage annotation file
cover/ # Folder holding coverage output
.coverage # Data file storing coverage results
.coverage.* # Parallel coverage data files created when tests run across multiple processes
coverage.xml # Coverage report exported in XML format
htmlcov/ # Folder containing an HTML coverage report
.hypothesis/ # Cache folder used by the Hypothesis testing library
nosetests.xml # Test report generated by the Nose testing framework
.nox/ # Cache folder used by the Nox automation tool
*.py.cover # Per-file coverage annotation
.pytest_cache/ # Cache folder used by Pytest
.tox/ # Cache folder used by the Tox testing automation tool
